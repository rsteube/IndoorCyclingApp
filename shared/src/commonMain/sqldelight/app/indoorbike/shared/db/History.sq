CREATE TABLE WorkoutSession (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    workoutId TEXT NOT NULL,
    workoutName TEXT NOT NULL,
    startTimeEpoch INTEGER NOT NULL,
    durationSeconds INTEGER NOT NULL,
    avgPower INTEGER NOT NULL,
    avgCadence INTEGER NOT NULL,
    avgHeartRate INTEGER NOT NULL,
    -- Globally-unique stable id, used by the backup-sync layer to dedupe
    -- sessions across devices. Never reused, never edited. Empty string
    -- represents "needs backfill" — only present transiently during the
    -- migration from v1 → v2 of this schema, until the post-upgrade
    -- backfill query in HistoryRepository fills the column. New inserts
    -- supply a non-empty value.
    externalId TEXT NOT NULL DEFAULT '',
    -- When Intervals.icu last accepted this ride, or 0 for never. Lives on the
    -- ride rather than in a screen's memory so the answer survives navigating
    -- away and restarting the app. A timestamp rather than a flag because the
    -- upload can succeed without a parseable activity id coming back.
    intervalsUploadedEpoch INTEGER NOT NULL DEFAULT 0,
    -- Same, for the rider's own FitTrackee server. 0 = never.
    fitTrackeeUploadedEpoch INTEGER NOT NULL DEFAULT 0,
    -- How far along its route a simulated ride got, and how much of the route's
    -- climbing it collected. Zero for every other mode, which is also what the
    -- post-ride screen reads as "this ride had no road under it". The route is
    -- named by workoutId ("simulation:<routeId>") and lives in the route
    -- catalogue; only the rider's progress along it needs storing, because it
    -- is the one thing that cannot be reconstructed afterwards.
    routeDistanceMeters REAL NOT NULL DEFAULT 0.0,
    routeElevationGainMeters REAL NOT NULL DEFAULT 0.0,
    -- Where on the road the ride began. Non-zero only for a route picked up
    -- part way, and the reason the two columns above cannot be read as "what
    -- this ride did": they are positions, and this is the origin to measure
    -- them from.
    routeStartMeters REAL NOT NULL DEFAULT 0.0,
    routeStartElevationGainMeters REAL NOT NULL DEFAULT 0.0
);

-- Non-unique because the v1 → v2 migration leaves multiple rows with the
-- empty-string default until the Kotlin-side backfill runs; a UNIQUE
-- constraint would reject the migration. Application-level discipline
-- (each insert supplies "$deviceId:${UUID}") guarantees uniqueness in
-- practice.
CREATE INDEX ix_workout_session_external_id ON WorkoutSession(externalId);

CREATE TABLE WorkoutTelemetry (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    sessionId INTEGER NOT NULL,
    timestampEpoch INTEGER NOT NULL,
    power INTEGER NOT NULL,
    cadence INTEGER NOT NULL,
    heartRate INTEGER NOT NULL,
    FOREIGN KEY (sessionId) REFERENCES WorkoutSession(id) ON DELETE CASCADE
);

insertSession:
INSERT INTO WorkoutSession (workoutId, workoutName, startTimeEpoch, durationSeconds, avgPower, avgCadence, avgHeartRate, externalId, routeDistanceMeters, routeElevationGainMeters, routeStartMeters, routeStartElevationGainMeters)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertRowId:
SELECT last_insert_rowid();

insertTelemetry:
INSERT INTO WorkoutTelemetry (sessionId, timestampEpoch, power, cadence, heartRate)
VALUES (?, ?, ?, ?, ?);

selectAllSessions:
SELECT * FROM WorkoutSession ORDER BY startTimeEpoch DESC;

selectTelemetryForSession:
SELECT * FROM WorkoutTelemetry WHERE sessionId = ? ORDER BY timestampEpoch ASC;

selectSessionById:
SELECT * FROM WorkoutSession WHERE id = ?;

selectSessionByExternalId:
SELECT * FROM WorkoutSession WHERE externalId = ?;

selectSessionsNeedingExternalIdBackfill:
SELECT * FROM WorkoutSession WHERE externalId = '';

updateSessionExternalId:
UPDATE WorkoutSession SET externalId = ? WHERE id = ?;

markIntervalsUploaded:
UPDATE WorkoutSession SET intervalsUploadedEpoch = ? WHERE id = ?;

markFitTrackeeUploaded:
UPDATE WorkoutSession SET fitTrackeeUploadedEpoch = ? WHERE id = ?;

deleteTelemetryForSession:
DELETE FROM WorkoutTelemetry WHERE sessionId = ?;

deleteSession:
DELETE FROM WorkoutSession WHERE id = ?;
