<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground layer for the adaptive launcher icon.

  Canvas is 108x108 dp. The central 72x72 dp is the "safe zone" — content
  outside it may be cropped by OEM mask shapes (circle, squircle, teardrop,
  etc.). The source mark is 64x64; translating by 28 and scaling by 0.8125
  puts it at 52 dp centred, comfortably inside the safe zone with room for
  the parallax some launchers apply.

  Converted by hand from slate-design-system/logo/app-icon-foreground.svg.
  The circles are arcs because vector drawables have no <circle>, and the
  group's scale multiplies the stroke widths exactly as the SVG's does.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="28"
        android:translateY="28"
        android:scaleX="0.8125"
        android:scaleY="0.8125">

        <!-- Ridge -->
        <path
            android:pathData="M4,26 L14,16 L22,22 L32,10 L44,20 L54,14 L60,20"
            android:strokeColor="#9AA1B0"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />

        <!-- Front wheel -->
        <path
            android:pathData="M40,48 A8,8 0 1,0 56,48 A8,8 0 1,0 40,48 Z"
            android:strokeColor="#F2F4F7"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />

        <!-- Frame and saddle -->
        <path
            android:pathData="M32,48 L28,32 L44,30 L44,38 L48,48 M32,48 L44,38 M32,48 L16,48 L28,32 M24,32 L32,32 M40,28 Q44,26 48,28 Q50,30 49,33"
            android:strokeColor="#F2F4F7"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />

        <!-- Trainer flywheel, on the rear axle -->
        <path
            android:pathData="M9,48 A7,7 0 1,0 23,48 A7,7 0 1,0 9,48 Z"
            android:fillColor="#F2F4F7" />

        <!-- Trainer leg and foot -->
        <path
            android:pathData="M16,55 L16,58 M6,58 L26,58"
            android:strokeColor="#F2F4F7"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />
    </group>
</vector>
